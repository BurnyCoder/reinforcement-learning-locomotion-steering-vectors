# Sources: https://git-scm.com/docs/gitattributes ; preserve scientific binary artifacts exactly.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.pdf binary
*.npz binary
*.png binary
*.mp4 binary
# Preserve this original inspection and captured logs byte-for-byte; https://git-scm.com/docs/gitattributes#_text
reports/ant-classic-005/audit/fitting-inspection.json -text
reports/documentation-audit/*.log -text -whitespace
