# Sources: https://git-scm.com/docs/gitattributes ; preserve scientific binary artifacts exactly.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.in text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
site/*.js text eol=lf
site/*.html text eol=lf
site/*.css text eol=lf
*.pdf binary
*.npz binary
*.png binary
*.mp4 binary
# Preserve this original inspection and captured logs byte-for-byte; https://git-scm.com/docs/gitattributes#_text
reports/ant-classic-005/audit/fitting-inspection.json -text -whitespace
reports/documentation-audit/*.log -text -whitespace
# Keep the registered Ant logs identical in Git archives and Windows/Linux checkouts.
# These original CRLF bytes are pinned by reports/ant-publication/inputs.json.
reports/ant-classic-005/*.log -text -whitespace
reports/ant-classic-005-independent-audit/*.log -text -whitespace
reports/ant-classic-005-mechanism-audit/*.log -text -whitespace
reports/ant-classic-005-y-shift-audit/*.log -text -whitespace
# Captured failure traces intentionally retain whitespace from the reporting tool.
reports/ant-publication/logs/*.log -whitespace
# The publication's evidence includes this registry's raw SHA256, so retain its original bytes too.
reports/ant-publication/inputs.json -text -whitespace
