# Local configuration; copy to .env. No credentials belong in this file.
STEERING_TORCH_THREADS=1
STEERING_ROLLOUT_WORKERS=4
STEERING_MAX_STEPS=1000
STEERING_WARMUP=100
STEERING_DIAGNOSTIC_EPISODES=16
STEERING_FIT_EPISODES=64
STEERING_VALIDATION_EPISODES=10
STEERING_CONFIRMATION_EPISODES=30
STEERING_REPLICATION_EPISODES=30
STEERING_SEED_OFFSET=0
STEERING_FIT_MIN_SPEED_FRACTION=0.5
# Prespecify the same comma-separated signed grid for candidates and controls; zero is collected separately.
# Values must be finite, unique, nonzero, include both signs, and have distinct nonzero four-decimal cache labels.
# A finer example is -0.025,-0.01,-0.005,0.005,0.01,0.025. Changing the grid requires a new experiment.
STEERING_STRENGTH_GRID=-0.5,-0.2,-0.1,-0.05,0.05,0.1,0.2,0.5
